# Code Quest Server Configuration
PORT=3001

# Optional: Enable Live AI Coding Mentor (OpenAI or Gemini)
# If left empty, Code Quest uses its built-in Smart Offline Mentor automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
